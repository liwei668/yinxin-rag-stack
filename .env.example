# 环境变量配置文件
# 复制此文件为 .env 并修改为实际值

# ============================================
# 应用配置
# ============================================
NODE_ENV=production

# ============================================
# MongoDB 配置
# ============================================
# 如果使用 Docker 内置 MongoDB，保持默认值
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/yinxin-agl?authSource=admin
# 如果使用外部 MongoDB，修改为：
# MONGODB_URI=mongodb://用户名:密码@你的服务器IP:27017/yinxin-agl?authSource=admin

# MongoDB root 用户（仅 Docker 内置 MongoDB 需要）
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123

# ============================================
# Redis 配置
# ============================================
# 如果使用 Docker 内置 Redis，保持默认值
REDIS_URL=redis://redis:6379
# 如果使用外部 Redis 且有密码，修改为：
# REDIS_URL=redis://:密码@你的服务器IP:6379
REDIS_PASSWORD=

# ============================================
# 阿里云 DashScope API（语音合成）
# ============================================
DASHSCOPE_API_KEY=sk-237b5a8ea8ca4fbc92fab068d567b323
